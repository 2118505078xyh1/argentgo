{
  "version": "{{VERSION}}",
  "description": "Personal coding-agent harness: streaming model replies, tools, JSONL sessions, a full-screen TUI and a native Windows desktop UI.",
  "homepage": "https://example.com/argentgo",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://example.com/argentgo/releases/download/v{{VERSION}}/argentgo_{{VERSION}}_windows_amd64.zip",
      "hash": "{{SHA256}}",
      "extractor": "zip",
      "bin": [
        "argentgo.exe",
        "argentgo-native.exe"
      ]
    }
  },
  "checkver": {
    "github": "https://example.com/argentgo"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://example.com/argentgo/releases/download/v$version/argentgo_$version_windows_amd64.zip",
        "hash": {
          "url": "https://example.com/argentgo/releases/download/v$version/checksums.txt",
          "regex": "(?i)([a-f0-9]{64})\\s+argentgo_[0-9.]*_windows_amd64\\.zip",
          "capture": 1
        }
      }
    }
  }
}
